<section class="statement section">
  <div class="statement__inner container">
    <p class="statement__text">
      As a small business myself, I know every euro counts. That’s why I take
      the time to understand your goals before I design anything, so your
      website works as hard as you do.
    </p>
    <a class="statement__link fw-bold" href="/about">
      How I work
    </a>
  </div>
</section>

<style lang="scss">
  @use "../styles/abstracts" as *;
  .statement {
    background-color: $statement-background-color;

    &__inner {
      display: grid;
      gap: $size-10;

      @include mq(medium) {
        grid-template-columns: 1fr 1fr;

        > * {
          grid-column: 2;
        }
      }
    }

    &__text {
      font-size: $font-size-700;
      font-weight: $font-weight-semi-bold;
      line-height: 1.3;
    }

    &__link {
      justify-self: end; // pushes it to the right edge of the column
      text-transform: uppercase;
      letter-spacing: 0.05em; // uppercase text looks better slightly spaced
      text-underline-offset: 0.4em; // moves the underline down, like the example
      color: $statement-link-color;

      &:is(:hover, :focus) {
        color: $statement-link-color-hover;
      }
    }
  }
</style>

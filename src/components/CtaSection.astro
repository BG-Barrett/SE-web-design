---
import CtaPanel from "../components/CtaPanel.astro";
---

<section class="cta section">
  <div class="cta__content container text-center">
    <h2 class="heading-2 padding-block-end-10">
      Is Your Website Losing Your Business Opportunities?
    </h2>
    <p class="fs-500 padding-block-end-10">
      Get a free website audit today and find what your business is missing.
    </p>
    <CtaPanel
      theme="primary"
      src="/images/macbook-air-on-desk.jpg"
      alt="Laptop"
      show={["name", "email"]}
      buttonText="More Info"
    />
  </div>
</section>

---
import Card from "./Card.astro";
import { reviews } from "../data/reviews";
---

<section class="reviews section">
  <div class="container text-center">
    <h2 class="heading-2 padding-block-end-10">Reviews</h2>

    <ul class="reviews__list grid-auto-fit" role="list">
      {reviews.map((review) => (
        <Card El="li" theme="review">
          <p class="reviews__rating">
            <span aria-hidden="true">
              {"★".repeat(review.rating)}
              {"☆".repeat(5 - review.rating)}
            </span>
            <span class="visually-hidden">Rated {review.rating} out of 5</span>
          </p>
          <figure>
            <blockquote>
              <p class="reviews__quote">{review.quote}</p>
            </blockquote>
            <figcaption>
              {review.business
                ? `${review.name}, ${review.business}`
                : review.name}
            </figcaption>
          </figure>
        </Card>
      ))}
    </ul>
  </div>
</section>

<style lang="scss">
  @use "../styles/abstracts" as *;

  .reviews {
    background-color: $reviews-backgrounds-color;

    figcaption {
      font-size: $review-figcaption-font-size;
      font-weight: $review-figcaption-font-weight;
    }

    &__rating {
      color: $review-star-color;
      font-size: $font-size-500;
      letter-spacing: 0.1em; // a little space between stars
    }

    &__quote::before {
      content: "\201C"; // the “ character
      display: block;
      font-size: $font-size-900;
      line-height: 1;
      color: $review-quote-color; // or any colour token
    }
  }
</style>

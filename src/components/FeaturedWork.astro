---
import { work } from "../data/work";

interface Props {
  limit?: number;
}

const { limit = 7 } = Astro.props;
const items = work.slice(0, limit);
---

<ul class="work__grid" role="list">
  {items.map((item) => (
    <li class="work__item">
      <img class="work__image" src={item.src} alt={item.alt} />
      <p class="work__title visually-hidden">{item.title}</p>
    </li>
  ))}
</ul>

<style lang="scss">
  @use "../styles/abstracts/" as *;

  .work {
    &__grid {
      display: grid;
      gap: $grid-gap;
      grid-template-columns: repeat(2, 1fr);
      list-style: none;

      @include mq(medium) {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    &__image {
      width: 100%;
      aspect-ratio: 2 / 1;
      object-fit: cover;
      transition: transform 400ms ease;
    }

    &__item {
      overflow: hidden;
    }

    &__item:nth-child(2) {
      grid-row: span 2;
    }

    &__item:nth-child(2) &__image {
      height: 100%;
      aspect-ratio: auto;
    }

    &__item:hover &__image {
      transform: scale(1.05);
    }
    @media (prefers-reduced-motion: no-preference) {
      &__image {
        transition: transform 400ms ease;
      }
    }
  }
</style>
